[Unit]
Description=HARROW - The Resonant CMO Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/harrow
EnvironmentFile=/var/www/harrow/.env
ExecStart=/usr/bin/python3 -m uvicorn harrow_agent:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
