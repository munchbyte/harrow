# HARROW — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env.

# Agent auth — used for dashboard login and all API calls
HARROW_API_KEY=

# Anthropic — Claude API for copy generation, gates, briefs
ANTHROPIC_API_KEY=

# Outscraper — Google Maps scraping (Workflow A)
OUTSCRAPER_API_KEY=

# Firecrawl — Website scraping (Workflow B Ghost Audit)
FIRECRAWL_API_KEY=

# Google Sheets — Master Lead Sheet
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Vapi — Voice agent management
VAPI_API_KEY=

# Push CMS — Tier-3 sub-agent (live since 2026-05-01)
# Internal calls only — both HARROW and Push run on the same VPS.
# Public URL https://push.goblinmedia.net is for reference; do not use it for HARROW->Push calls.
PUSH_CMS_AGENT_URL=http://localhost:8004
PUSH_CMS_API_KEY=                 # generated on Push VPS, see /opt/push-cms/.env

# Interact CRM — Tier-3 sub-agent
# Internal calls only — Interact runs on the same VPS as HARROW.
INTERACT_AGENT_URL=http://localhost:8003
INTERACT_API_KEY=                 # generated on Interact VPS, see Interact's .env

# ntfy.sh — One-Touch Receipt notifications
NTFY_TOPIC=
NTFY_SECRET=
